{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "APP_VARIANT": "development", "EXPO_NO_DOTENV": "1" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "production",
      "env": { "APP_VARIANT": "production", "EXPO_NO_DOTENV": "1" },
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "env": { "APP_VARIANT": "staging", "EXPO_NO_DOTENV": "1" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "environment": "production",
      "env": { "APP_VARIANT": "production", "EXPO_NO_DOTENV": "1" },
      "android": { "buildType": "app-bundle" }
    }
  }
}
